{# 廟方管理員登入 / 內容編輯浮動控制列。JS 在 admin.js。 #}
<div class="admin-corner">
  <div class="admin-status admin-only" id="adminStatusBadge">管理員模式</div>

  <button class="admin-corner-btn google-btn" id="googleLoginBtn" type="button">
    <svg viewBox="0 0 48 48" width="16" height="16" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.1 8 3.1l5.7-5.7C34.5 6.1 29.5 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.9 18.9 13 24 13c3.1 0 5.9 1.1 8 3.1l5.7-5.7C34.5 6.1 29.5 4 24 4c-7.5 0-14 4.2-17.7 10.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.4 35.4 26.8 36 24 36c-5.3 0-9.7-3.1-11.3-7.6l-6.6 5.1C9.9 39.7 16.4 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.1 5.7l6.3 5.3C40.9 36.4 44 30.8 44 24c0-1.3-.1-2.7-.4-3.5z"/></svg>
    使用 Google 登入
  </button>

  <div class="user-chip" id="userChip" hidden>
    <img id="userAvatar" src="" alt="">
    <div class="user-chip-text">
      <span id="userName"></span>
      <span id="userEmail"></span>
    </div>
  </div>
  <button class="admin-corner-btn admin-only" id="editToggleBtn" type="button">開始編輯內容</button>
  <button class="admin-corner-btn primary admin-only" id="saveBtn" type="button" hidden>儲存變更</button>
  <button class="admin-corner-btn" id="logoutBtn" type="button" hidden>登出</button>
</div>
<div class="save-toast" id="saveToast" role="status" aria-live="polite">已儲存變更</div>
