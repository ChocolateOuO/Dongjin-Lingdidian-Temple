<footer>
  <div class="footer-couplets" aria-hidden="true">
    <span class="footer-lion">
      <svg viewBox="0 0 40 44">
        <circle cx="20" cy="20" r="12" fill="none" stroke="var(--gold)" stroke-width="1.8"/>
        <path d="M9 13 Q14 3 20 7 Q26 3 31 13" fill="none" stroke="var(--gold)" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="15.5" cy="19" r="1.5" fill="var(--gold)"/>
        <circle cx="24.5" cy="19" r="1.5" fill="var(--gold)"/>
        <path d="M15.5 25 Q20 28.5 24.5 25" fill="none" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </span>
    <div class="couplet-panel"><span>風調雨順</span></div>
    <div class="footer-motif" aria-hidden="true">
      <svg viewBox="0 0 40 40">
        <path d="M6 24 Q10 14 20 16 Q26 6 34 14 Q30 22 22 20 Q16 28 6 24Z" fill="none" stroke="var(--gold)" stroke-width="1.6" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="couplet-panel"><span>國泰民安</span></div>
    <span class="footer-lion">
      <svg viewBox="0 0 40 44">
        <circle cx="20" cy="20" r="12" fill="none" stroke="var(--gold)" stroke-width="1.8"/>
        <path d="M9 13 Q14 3 20 7 Q26 3 31 13" fill="none" stroke="var(--gold)" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="15.5" cy="19" r="1.5" fill="var(--gold)"/>
        <circle cx="24.5" cy="19" r="1.5" fill="var(--gold)"/>
        <path d="M15.5 25 Q20 28.5 24.5 25" fill="none" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </span>
  </div>

  <nav class="footer-nav" aria-label="頁尾導覽">
    {% for item in site.nav %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}
    <a href="/journal/">廟誌文史</a>
  </nav>

  {% if site.social.facebook or site.social.line %}
  <div class="footer-social">
    {% if site.social.facebook %}<a href="{{ site.social.facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
    {% if site.social.line %}<a href="{{ site.social.line }}" target="_blank" rel="noopener">LINE</a>{% endif %}
  </div>
  {% endif %}

  <div class="footer-contact">
    {{ site.contact.address }}　｜　{{ site.contact.phone }}（{{ site.contact.phoneNote }}）
  </div>
  <div>© <span id="footerYear">{{ '' | year }}</span> {{ site.name }}．{{ site.contact.addressShort }}</div>
  <div style="margin-top:6px;opacity:.85;">網站內容以廟方公告為準</div>
  <button type="button" class="theme-toggle" id="themeToggle" aria-label="切換日間／夜間模式">☾ 夜間模式</button>
</footer>
