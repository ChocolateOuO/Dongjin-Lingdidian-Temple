---
layout: layouts/base.njk
---
<section class="page-head" data-glyph="{{ glyph }}" style="padding-top:56px;">
  <div class="container">
    <div class="eyebrow">{{ eyebrow }}</div>
    <h2 class="title">{{ heading }}</h2>
    <p class="lede">{{ stubNote or "本分頁內容整備中，將於近期上線，敬請期待。" }}</p>
    <p style="margin-top:28px;">
      <a class="pill-btn" href="/" style="border-color:var(--gold);color:var(--red-2);">← 回首頁</a>
    </p>
  </div>
</section>
