<!DOCTYPE html>
<html lang="{{ site.locale }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

{% set pageTitle = title if title else site.title %}
{% set pageDesc = description if description else site.description %}
{% set canonical = site.url + page.url %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ canonical }}">
<meta name="theme-color" content="#150d09">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:locale" content="zh_TW">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">

<link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
<link rel="manifest" href="/assets/icons/site.webmanifest">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;700;900&family=Noto+Sans+TC:wght@300;400;500&family=Ma+Shan+Zheng&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/assets/css/main.css">
{% for css in extraCss or [] %}<link rel="stylesheet" href="/assets/css/{{ css }}">
{% endfor %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PlaceOfWorship",
  "name": "{{ site.name }}",
  "url": "{{ site.url }}",
  "telephone": "{{ site.contact.phone }}",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "TW",
    "addressRegion": "屏東縣",
    "addressLocality": "東港鎮",
    "streetAddress": "盛漁里興漁街1號",
    "postalCode": "928"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ site.contact.geo.lat }},
    "longitude": {{ site.contact.geo.lng }}
  }
}
</script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

<a class="skip-link" href="#main">跳到主要內容</a>

{% include "partials/intro-gate.njk" %}
{% include "partials/nav.njk" %}

<button class="back-to-top" id="backToTop" aria-label="回到頂部" onclick="window.scrollTo({top:0,behavior:'smooth'});">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 5 L19 13 L15.5 13 L15.5 19 L8.5 19 L8.5 13 L5 13 Z" fill="currentColor"/></svg>
</button>

{% include "partials/admin-bar.njk" %}

<main id="main">
{{ content | safe }}
</main>

<div class="lightbox" id="lightbox">
  <button class="close" type="button" aria-label="關閉" onclick="closeLightbox()">✕</button>
  <div>
    <img id="lightboxImg" src="" alt="">
    <div class="cap" id="lightboxCap"></div>
  </div>
</div>

{% include "partials/footer.njk" %}

<script src="/assets/js/site.js" defer></script>
{% for js in extraJs or [] %}<script src="/assets/js/{{ js }}" defer></script>
{% endfor %}
</body>
</html>
