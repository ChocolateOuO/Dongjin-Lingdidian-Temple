  "sticks": [
    { "no": 1, "gz": "甲子", "level": "上", "poem": ["日出便見風雲散", "光明清淨照世間", "一向前途通大道", "萬事清吉保平安"], "holy": "大吉。撥雲見日，前程光明。", "explain": "久困之運至此得解，凡事漸入佳境，只要秉持正道向前，自然平安順遂、諸事清吉。", "plain": "大吉之兆，撥雲見日，凡事順遂，可放心前行。", "aspects": { "求財": "順遂，可得", "婚姻": "成", "功名": "有望", "疾病": "漸癒", "家運": "興旺", "行人": "將至", "失物": "可尋", "訴訟": "和解為吉" } },
    { "no": 2, "gz": "甲寅", "level": "上", "poem": ["於今此景正當時", "看看欲吐百花魁", "若能遇得春色到", "一洒清吉脫塵埃"], "holy": "時機將至，把握則吉。", "explain": "如花含苞待放，好運正要到來。趁勢而為、不可錯過時機，便能一掃陰霾、轉入清吉。", "plain": "春回大地，機運漸開，把握眼前時機可得吉慶。", "aspects": { "求財": "漸有", "婚姻": "可成", "功名": "及時可得", "疾病": "待時漸安", "家運": "轉好", "行人": "有信", "失物": "遲得", "訴訟": "宜緩則吉" } },
    { "no": 3, "gz": "甲辰", "level": "上", "poem": ["勸君把定心莫虛", "天註衣祿自有餘", "和合重重常吉慶", "時來終遇得明珠"], "holy": "守正待時，貴人相扶。", "explain": "衣食自有天定，不必憂慮。只要心志堅定、與人和合，時機一到便有貴人成全，得償所願。", "plain": "心誠意堅，衣食自有餘裕，貴人自來成全好事。", "aspects": { "求財": "有餘", "婚姻": "和合大吉", "功名": "終得", "疾病": "無礙", "家運": "吉慶", "行人": "平安", "失物": "可得", "訴訟": "得理" } },
    { "no": 4, "gz": "甲午", "level": "上", "poem": ["風恬浪靜可行舟", "恰是中秋月一輪", "凡事不須多憂慮", "福祿自有慶家門"], "holy": "風平浪靜，福祿臨門。", "explain": "時運安穩如中秋明月，行事順利無阻。不必過度掛慮，福澤自然臨於家門。", "plain": "風平浪靜，諸事穩妥，不必過度憂慮，福祿自來。", "aspects": { "求財": "穩得", "婚姻": "美滿", "功名": "順利", "疾病": "平安", "家運": "安泰", "行人": "即歸", "失物": "在近處", "訴訟": "無事" } },
    { "no": 5, "gz": "甲申", "level": "中", "poem": ["只恐前途命有變", "勸君作急可宜先", "且守長江無大事", "命逢太白守身邊"], "holy": "事有變數，宜早防範。", "explain": "前路或有變化，凡事宜提早準備、先發制人。守成則無大礙，妄動恐生枝節。", "plain": "事有變數，宜謹慎行事，安守本分方能無虞。", "aspects": { "求財": "宜守", "婚姻": "宜緩", "功名": "未定", "疾病": "宜早治", "家運": "平", "行人": "有阻", "失物": "難尋", "訴訟": "宜和" } },
    { "no": 6, "gz": "甲戌", "level": "下", "poem": ["風雲致雨落洋洋", "天災時氣必有傷", "命內此事難和合", "更逢一足出外鄉"], "holy": "時運不濟，宜守勿進。", "explain": "近期恐有意外波折或耗損，所謀之事難以和合。宜安分守己、暫緩行動，等待時運轉開。", "plain": "恐有意外波折，行事宜多加防範，暫緩躁進。", "aspects": { "求財": "不利", "婚姻": "難成", "功名": "無望", "疾病": "宜謹慎", "家運": "欠安", "行人": "未歸", "失物": "難尋", "訴訟": "不利" } },
    { "no": 7, "gz": "乙丑", "level": "上", "poem": ["雲開月出正分明", "不須進退問前程", "婚姻皆由天註定", "和合清吉萬事成"], "holy": "撥雲見月，天定佳期。", "explain": "疑慮已消、前途分明，不必再猶豫進退。姻緣自有天定，順其自然便能和合成事。", "plain": "婚姻前程自有天定，不必猶疑，終能圓滿。", "aspects": { "求財": "可得", "婚姻": "天定必成", "功名": "分明有得", "疾病": "漸安", "家運": "清吉", "行人": "將返", "失物": "可尋", "訴訟": "和吉" } },
    { "no": 8, "gz": "乙卯", "level": "上", "poem": ["禾稻看看結成完", "此事必定兩相全", "回到家中寬心坐", "妻兒鼓舞樂團圓"], "holy": "苦盡甘來，事得兩全。", "explain": "如禾稻結實在望，所求之事可望圓滿收成，兩相皆宜。歷經辛勞後終得團圓和樂。", "plain": "所求之事可望圓滿，家庭和樂，苦盡甘來。", "aspects": { "求財": "收成", "婚姻": "兩全", "功名": "得成", "疾病": "將癒", "家運": "團圓", "行人": "歸", "失物": "得", "訴訟": "和解" } },
    { "no": 9, "gz": "乙巳", "level": "中", "poem": ["龍虎相隨在深山", "君爾何須背後看", "不知此去相愛愉", "他日與我卻無干"], "holy": "緣分難久，看淡為宜。", "explain": "所交往之人緣分恐不長久，不必過度眷戀或回頭張望。得失隨緣、順其自然即可。", "plain": "兩人緣分恐難長久，看淡得失，順其自然即可。", "aspects": { "求財": "反覆", "婚姻": "難久", "功名": "未定", "疾病": "反覆", "家運": "平", "行人": "去意已決", "失物": "難得", "訴訟": "拖延" } },
    { "no": 10, "gz": "乙未", "level": "下", "poem": ["花開結子一半枯", "可惜今年汝虛度", "漸漸日落西山去", "勸君不用向前途"], "holy": "運勢已衰，宜守勿求。", "explain": "如花結子而半枯，今年運勢不順，勉力強求只是徒勞。宜守成待時，不宜躁進。", "plain": "運勢稍歇，今年宜守成，不宜躁進強求。", "aspects": { "求財": "不利", "婚姻": "難成", "功名": "無", "疾病": "遷延", "家運": "欠安", "行人": "未歸", "失物": "不得", "訴訟": "不利" } },
    { "no": 11, "gz": "乙酉", "level": "中", "poem": ["靈雞漸漸見分明", "凡事且看子丑寅", "雲開月出照天下", "郎君即便見太平"], "holy": "曙光漸露，耐心等待。", "explain": "事情正逐漸明朗，宜靜待時日（子丑寅時或月份）。雲開月出之時，自見太平。", "plain": "事情逐漸明朗，耐心等待，終見天日。", "aspects": { "求財": "漸有", "婚姻": "待時可成", "功名": "漸明", "疾病": "漸癒", "家運": "轉安", "行人": "將至", "失物": "遲得", "訴訟": "漸解" } },
    { "no": 12, "gz": "乙亥", "level": "上", "poem": ["長江風浪漸漸靜", "于今得進可安寧", "必有貴人相扶助", "凶事脫出見太平"], "holy": "風浪漸息，貴人化險。", "explain": "動盪漸趨平靜，此時進取可得安寧。將有貴人相助，化解凶險、重見太平。", "plain": "風浪漸息，安穩可期，貴人相助化險為夷。", "aspects": { "求財": "可得", "婚姻": "得助則成", "功名": "貴人提攜", "疾病": "轉安", "家運": "轉吉", "行人": "平安歸", "失物": "得人助尋", "訴訟": "得解" } },
    { "no": 13, "gz": "丙子", "level": "下", "poem": ["命中正逢羅孛關", "用盡心機總未休", "作福問神難得過", "恰是行舟上高灘"], "holy": "諸事阻滯，強求無益。", "explain": "正逢阻礙之運，費盡心思仍難如願，如行舟擱淺高灘。宜靜心行善、待時而動，不可強求。", "plain": "諸事阻滯難行，強求無益，宜靜待時機。", "aspects": { "求財": "難得", "婚姻": "阻", "功名": "未遂", "疾病": "遷延", "家運": "欠安", "行人": "有阻", "失物": "難尋", "訴訟": "膠著" } },
    { "no": 14, "gz": "丙寅", "level": "中", "poem": ["財中漸漸見分明", "花開花謝結子成", "寬心且看月中桂", "郎君即便見太平"], "holy": "財運漸明，寬心待成。", "explain": "財路正逐漸清晰，如花開花謝而後結子。放寬心懷、靜待時機，好事自然到來。", "plain": "財運漸露曙光，寬心靜待，好事自然來到。", "aspects": { "求財": "漸有", "婚姻": "可成", "功名": "漸得", "疾病": "漸安", "家運": "轉好", "行人": "將至", "失物": "遲得", "訴訟": "漸解" } },
    { "no": 15, "gz": "丙辰", "level": "中", "poem": ["八十原來是太公", "看看晚景遇文王", "目下緊事休相問", "勸君且守待運通"], "holy": "時機未到，韜光養晦。", "explain": "如姜太公八十遇文王，成就在後不在前。眼前急切之事不必強問，宜守分修為、靜待時來運轉。", "plain": "時機未到，宜韜光養晦，靜待時來運轉。", "aspects": { "求財": "待時", "婚姻": "宜緩", "功名": "晚成", "疾病": "遷延", "家運": "平", "行人": "遲歸", "失物": "遲得", "訴訟": "宜緩" } },
    { "no": 16, "gz": "丙午", "level": "下", "poem": ["不須作福不須求", "用盡心機總未休", "陽世不知陰世事", "官法如爐不自由"], "holy": "運塞事阻，順其自然。", "explain": "此事牽連甚廣、非人力所能強為，愈是費心愈難稱意。宜靜守本分、廣行善事，不可鑽營。", "plain": "諸事難成，強求無用，宜順其自然。", "aspects": { "求財": "不得", "婚姻": "難成", "功名": "無", "疾病": "宜謹慎", "家運": "欠安", "行人": "未歸", "失物": "不得", "訴訟": "不利，宜和" } },
    { "no": 17, "gz": "丙申", "level": "中", "poem": ["舊恨重重未改為", "家中禍患不臨身", "須當謹防宜作福", "龍蛇交會得和合"], "holy": "宿怨未解，謹防作福。", "explain": "舊有嫌隙尚未化解，家中宜多留意、謹慎防範並廣行善事。待時機交會，自可轉為和合。", "plain": "家中宜多留意，謹慎行事、廣行善事可保平安。", "aspects": { "求財": "平", "婚姻": "宜慎", "功名": "未定", "疾病": "宜作福", "家運": "宜謹防", "行人": "有信", "失物": "難尋", "訴訟": "宜和解" } },
    { "no": 18, "gz": "丙戌", "level": "中", "poem": ["君問中間此言因", "看看祿馬拱前程", "若得貴人多得利", "和合自有兩分明"], "holy": "祿馬拱照，貴人得利。", "explain": "前程有祿馬星拱照，若能得貴人相助則多有利益，事情也將逐漸明朗和合。", "plain": "貴人扶持在望，事情將逐漸明朗有利。", "aspects": { "求財": "得貴人則利", "婚姻": "漸明", "功名": "有助", "疾病": "轉安", "家運": "漸吉", "行人": "有信", "失物": "得人助", "訴訟": "得理" } },
    { "no": 19, "gz": "丁丑", "level": "中", "poem": ["富貴由命天註定", "心高必然誤君期", "不然且回依舊路", "雲開月出自分明"], "holy": "富貴有命，勿好高騖遠。", "explain": "富貴自有定數，心志過高反而誤事。宜安守本分、依循原路而行，待雲開月出自然分明。", "plain": "富貴自有定數，切莫心高氣傲，安守本分為宜。", "aspects": { "求財": "守分則安", "婚姻": "宜守舊", "功名": "有定數", "疾病": "漸安", "家運": "平", "行人": "遲歸", "失物": "遲得", "訴訟": "宜守" } },
    { "no": 20, "gz": "丁卯", "level": "下", "poem": ["前途功名未得意", "只恐命內有交加", "兩家必定防損失", "勸君且退莫咨嗟"], "holy": "功名未遂，宜退防損。", "explain": "功名尚未如意，且恐有牽扯糾纏，雙方都須防範損失。宜暫退觀望，不必怨嘆。", "plain": "功名尚未如意，宜謹慎行事，暫且退讓觀望。", "aspects": { "求財": "防損", "婚姻": "宜緩", "功名": "未得", "疾病": "宜慎", "家運": "欠安", "行人": "未歸", "失物": "難尋", "訴訟": "宜退和" } },
    { "no": 21, "gz": "丁巳", "level": "上", "poem": ["十方佛法有靈通", "大難禍患不相同", "紅日當空常照耀", "還有貴人到家堂"], "holy": "神佛庇佑，貴人臨門。", "explain": "有神佛靈通庇護，縱有大難亦能化小。如紅日當空，光明普照，並有貴人來到家中相助。", "plain": "佛法庇佑，大難化小，貴人將至家中相助。", "aspects": { "求財": "得助可得", "婚姻": "吉", "功名": "有望", "疾病": "得庇轉安", "家運": "轉吉", "行人": "平安歸", "失物": "可尋", "訴訟": "得貴人解" } },
    { "no": 22, "gz": "丁未", "level": "上", "poem": ["太公家業八十成", "月出光輝四海明", "命內自然逢大吉", "茅屋中間百事亨"], "holy": "大器晚成，百事亨通。", "explain": "如姜太公八十始成家業，時機一到自然大吉。縱處平凡，諸事皆能順遂亨通。", "plain": "家業有成，光明在望，諸事皆能順遂亨通。", "aspects": { "求財": "終得", "婚姻": "成", "功名": "晚成必得", "疾病": "轉安", "家運": "興", "行人": "歸", "失物": "得", "訴訟": "得理" } },
    { "no": 23, "gz": "丁酉", "level": "下", "poem": ["欲去長江水闊茫", "前途未遂運未通", "如今絲綸常在手", "只恐魚水不相逢"], "holy": "運未通達，宜守待時。", "explain": "前路茫茫、時運未開，縱有準備也難逢良機。宜守成蓄勢，不宜貿然強求。", "plain": "前路茫然運勢未通，宜守成待時，勿躁進強求。", "aspects": { "求財": "難得", "婚姻": "難逢", "功名": "未遂", "疾病": "遷延", "家運": "欠安", "行人": "未歸", "失物": "不得", "訴訟": "膠著" } },
    { "no": 24, "gz": "丁亥", "level": "上", "poem": ["月出光輝四海明", "前途祿位見太平", "浮雲掃退終無事", "可保禍患不臨身"], "holy": "光明普照，禍患不侵。", "explain": "如明月出雲、四海皆明，前程祿位可期。障礙如浮雲終將散去，自可保平安無事。", "plain": "光明普照前程可期，浮雲散去，禍患不侵。", "aspects": { "求財": "可得", "婚姻": "成", "功名": "有祿位", "疾病": "將癒", "家運": "太平", "行人": "歸", "失物": "可尋", "訴訟": "無事" } },
    { "no": 25, "gz": "戊子", "level": "中", "poem": ["總是前途莫心勞", "求神問聖枉是多", "但看雞犬日過後", "不須作福事如何"], "holy": "徒勞無益，順其自然。", "explain": "為前途過度勞心並無助益，反覆問卜也是枉然。待時日一過（雞犬日後），自見分曉。", "plain": "徒勞心力無益，宜順其自然，靜待時機轉變。", "aspects": { "求財": "平", "婚姻": "隨緣", "功名": "未定", "疾病": "待時", "家運": "平", "行人": "自歸", "失物": "遲得", "訴訟": "宜緩" } },
    { "no": 26, "gz": "戊寅", "level": "上", "poem": ["選出牡丹第一枝", "勸君折取莫遲疑", "世間若問相知處", "萬事逢春正及時"], "holy": "良機當前，勿再遲疑。", "explain": "如選得牡丹第一枝，正是最好時機。當機立斷、把握良緣，萬事如逢春回，正合其時。", "plain": "良機當前，勿再遲疑，把握時機正逢其時。", "aspects": { "求財": "把握則得", "婚姻": "上上大吉", "功名": "及時可得", "疾病": "速癒", "家運": "興旺", "行人": "即歸", "失物": "速尋可得", "訴訟": "速和為吉" } },
    { "no": 27, "gz": "戊辰", "level": "上", "poem": ["君爾寬心且自由", "門庭清吉家無憂", "財寶自然終吉利", "凡事無傷不用求"], "holy": "門庭清吉，財利自來。", "explain": "可放寬心懷，家門平安無憂。財帛自然順利而來，凡事並無妨礙，不必刻意強求。", "plain": "心可寬放，家門清吉無憂，財利自然而來。", "aspects": { "求財": "自然得利", "婚姻": "吉", "功名": "順", "疾病": "無礙", "家運": "清吉", "行人": "平安", "失物": "可得", "訴訟": "無事" } },
    { "no": 28, "gz": "戊午", "level": "下", "poem": ["於今莫作此當時", "虎落平陽被犬欺", "世間凡事何難定", "千山萬水也遲疑"], "holy": "時運失勢，宜忍勿爭。", "explain": "如虎落平陽，暫時失勢受制於人。此時不宜強出頭，凡事宜多加考量、忍讓待時。", "plain": "時運不濟，恐受人欺，凡事宜多加考量。", "aspects": { "求財": "不利", "婚姻": "難成", "功名": "未遂", "疾病": "宜慎", "家運": "欠安", "行人": "有阻", "失物": "難尋", "訴訟": "不利，宜忍" } },
    { "no": 29, "gz": "戊申", "level": "中", "poem": ["枯木可惜未逢春", "如今反在暗中藏", "寬心且守風霜退", "還君依舊作乾坤"], "holy": "潛藏待時，終能復起。", "explain": "如枯木未逢春、暫時隱伏。宜寬心守候，待風霜退去，自能重整旗鼓、否極泰來。", "plain": "時機未到宜靜待，寬心守候終能否極泰來。", "aspects": { "求財": "待時", "婚姻": "宜緩", "功名": "晚成", "疾病": "遷延後癒", "家運": "先困後安", "行人": "遲歸", "失物": "遲得", "訴訟": "宜緩" } },
    { "no": 30, "gz": "戊戌", "level": "下", "poem": ["漸漸看此月中和", "過後須防未得高", "改變顏色前途去", "凡事必定見重勞"], "holy": "先順後阻，慎防辛勞。", "explain": "眼前雖見起色，過後仍須提防難以更上層樓。前路多變，凡事恐加倍辛勞，不可鬆懈。", "plain": "前路漸見起色，然仍須提防辛勞，不可鬆懈。", "aspects": { "求財": "先有後阻", "婚姻": "多波折", "功名": "難高", "疾病": "反覆", "家運": "先安後勞", "行人": "遲歸", "失物": "難尋", "訴訟": "拖延" } },
    { "no": 31, "gz": "己丑", "level": "上", "poem": ["綠柳蒼蒼正當時", "任君此去作乾坤", "花果結實無殘謝", "福祿自有慶家門"], "holy": "生機正盛，任意施為。", "explain": "如綠柳蒼蒼、正逢其時，此去可放手一搏、開創局面。所種必有收成，福祿臨於家門。", "plain": "生機蓬勃，正是耕耘時機，福祿自然隨之而來。", "aspects": { "求財": "得利", "婚姻": "成", "功名": "得", "疾病": "速癒", "家運": "興旺", "行人": "歸", "失物": "可得", "訴訟": "得理" } },
    { "no": 32, "gz": "己卯", "level": "下", "poem": ["龍虎相交在門前", "此事必定兩相連", "黃金忽然變成鐵", "何用作福問神仙"], "holy": "情勢反覆，不必強求。", "explain": "此事牽連兩造、糾纏難清，情勢反覆如黃金化鐵。宜順其自然、看淡得失，不必強求。", "plain": "情勢反覆不定，不必強求，順其自然為佳。", "aspects": { "求財": "得而復失", "婚姻": "多變", "功名": "未定", "疾病": "反覆", "家運": "欠安", "行人": "未定", "失物": "難得", "訴訟": "糾纏，宜和" } },
    { "no": 33, "gz": "己巳", "level": "中", "poem": ["欲去長江水闊茫", "行舟把定未遭風", "戶內用心再作福", "看看魚水得相逢"], "holy": "把穩用心，終能如願。", "explain": "前路雖茫，但只要把穩方向、行事謹慎，並於家中用心行善，終能如魚得水、如願以償。", "plain": "前途茫然但用心經營，終能如願以償。", "aspects": { "求財": "用心可得", "婚姻": "終成", "功名": "努力可得", "疾病": "作福漸安", "家運": "漸吉", "行人": "將至", "失物": "用心可尋", "訴訟": "漸解" } },
    { "no": 34, "gz": "己未", "level": "中", "poem": ["危險高山行過盡", "莫嫌此路有重重", "若見蘭桂漸漸發", "長蛇反轉變成龍"], "holy": "難關已過，否極泰來。", "explain": "最險的高山已經走過，不必再嫌路途多阻。待蘭桂漸發之時，自能由弱轉強、化蛇為龍。", "plain": "難關已過，漸見曙光，否極泰來指日可待。", "aspects": { "求財": "漸有", "婚姻": "先難後成", "功名": "苦後得", "疾病": "轉安", "家運": "轉吉", "行人": "將歸", "失物": "遲得", "訴訟": "漸解" } },
    { "no": 35, "gz": "己酉", "level": "中", "poem": ["此事何須用心機", "前途變怪自然知", "看看此去得和合", "漸漸脫出見太平"], "holy": "不必多慮，終見太平。", "explain": "此事不必費盡心機，前途變化自有分曉。順勢而行，終能和合、逐漸脫離困境見太平。", "plain": "不必多費心機，事情終將和合，撥雲見日。", "aspects": { "求財": "漸有", "婚姻": "和合", "功名": "漸得", "疾病": "漸安", "家運": "轉吉", "行人": "將至", "失物": "遲得", "訴訟": "漸和" } },
    { "no": 36, "gz": "己亥", "level": "上", "poem": ["福如東海壽如山", "君爾何須嘆苦難", "命內自然逢大吉", "祈保分明自平安"], "holy": "福壽雙全，大吉平安。", "explain": "福如東海、壽比南山，不必為一時苦難嘆息。命中自然逢大吉，誠心祈求便得分明平安。", "plain": "福壽雙全，大吉之兆，凡事皆能平安順遂。", "aspects": { "求財": "順得", "婚姻": "大吉", "功名": "有得", "疾病": "轉安", "家運": "福壽興旺", "行人": "平安歸", "失物": "可尋", "訴訟": "無事" } },
    { "no": 37, "gz": "庚子", "level": "上", "poem": ["運逢得意身顯變", "君爾身中皆有益", "一向前途無難事", "決意之中保清吉"], "holy": "時來運轉，顯達可期。", "explain": "正逢得意之運，處境將有向上的轉變，於己皆有助益。前途一路無阻，只要決心堅定便保清吉。", "plain": "時來運轉顯達在望，前途一片清吉無礙。", "aspects": { "求財": "得利", "婚姻": "成", "功名": "顯達", "疾病": "速癒", "家運": "興旺", "行人": "即歸", "失物": "可得", "訴訟": "得理" } },
    { "no": 38, "gz": "庚寅", "level": "上", "poem": ["名顯有意在中央", "不須祈禱心自安", "看看早晚日過後", "即時得意在其間"], "holy": "心安理得，時到自成。", "explain": "聲名將有所顯揚，心中坦然便自安穩，不必過度祈求。待時日一到，自然得意稱心。", "plain": "心安理得，時機一到便能如願得意。", "aspects": { "求財": "將得", "婚姻": "可成", "功名": "有得", "疾病": "漸安", "家運": "漸興", "行人": "將至", "失物": "遲得", "訴訟": "漸解" } },
    { "no": 39, "gz": "庚辰", "level": "中", "poem": ["意中若問神仙路", "勸爾且退望高樓", "寬心且守寬心坐", "必然遇得貴人扶"], "holy": "暫退守候，貴人自來。", "explain": "所問之事宜暫緩腳步、退一步觀望。放寬心懷、耐心守候，時機一到必有貴人前來相扶。", "plain": "宜暫緩腳步耐心等候，終將遇貴人相助。", "aspects": { "求財": "待時得助", "婚姻": "宜緩則成", "功名": "得貴人助", "疾病": "待時漸安", "家運": "先守後吉", "行人": "遲歸", "失物": "遲得", "訴訟": "宜緩" } },
    { "no": 40, "gz": "庚午", "level": "上", "poem": ["平生富貴成祿位", "君家門戶定光輝", "此中必定無損失", "夫妻百歲喜相隨"], "holy": "富貴穩固，家門光輝。", "explain": "一生富貴祿位皆能成就，家門光耀。此事並無損失之虞，夫妻和睦、相守到老。", "plain": "富貴祿位穩固，家門光輝，夫妻和睦到老。", "aspects": { "求財": "穩得", "婚姻": "白頭偕老", "功名": "有祿位", "疾病": "無礙", "家運": "光輝興旺", "行人": "平安歸", "失物": "可得", "訴訟": "無事" } },
    { "no": 41, "gz": "庚申", "level": "中", "poem": ["今行到此實難推", "歌歌暢飲自徘徊", "雞犬相聞消息近", "婚姻夙世結成雙"], "holy": "佳訊將近，姻緣夙定。", "explain": "眼前情勢一時難以推展，不妨從容以對。好消息已近在耳邊，姻緣乃前世註定，終將成雙。", "plain": "婚姻姻緣天注定，佳訊將至，宜寬心以待。", "aspects": { "求財": "將有", "婚姻": "夙世註定必成", "功名": "有信", "疾病": "漸安", "家運": "漸吉", "行人": "消息近", "失物": "遲得", "訴訟": "漸解" } },
    { "no": 42, "gz": "庚戌", "level": "下", "poem": ["一重江水一重山", "誰知此去路又難", "任他改求終不過", "是非終久未得安"], "holy": "重重阻隔，是非纏身。", "explain": "前路一重江水一重山，處處是難關。縱然改弦更張也難通過，是非糾纏一時難以平息。", "plain": "前路重重阻礙，是非糾纏難解，宜謹慎應對。", "aspects": { "求財": "難得", "婚姻": "多阻", "功名": "未遂", "疾病": "遷延", "家運": "多是非", "行人": "有阻", "失物": "難尋", "訴訟": "纏訟，宜和" } },
    { "no": 43, "gz": "辛丑", "level": "中", "poem": ["一年作事急如飛", "君爾寬心莫遲疑", "貴人還在千里外", "音信月中漸漸知"], "holy": "貴人在遠，音信將至。", "explain": "諸事進展雖快，仍宜寬心、不必猶疑。貴人尚在遠方，音訊將於月中逐漸傳來。", "plain": "事情進展雖急，宜寬心稍待，貴人音訊將至。", "aspects": { "求財": "待貴人則有", "婚姻": "待時可成", "功名": "有信", "疾病": "漸安", "家運": "漸吉", "行人": "月中有信", "失物": "遲得", "訴訟": "漸解" } },
    { "no": 44, "gz": "辛卯", "level": "中", "poem": ["客到前途多得利", "君爾何故兩相疑", "雖是中間逢進退", "月出光輝得運時"], "holy": "遠客帶利，勿生疑慮。", "explain": "有遠方之人或機會帶來利益，不必彼此猜疑。過程中雖有進退反覆，待月明之時便得好運。", "plain": "財利可期，雖有猶疑進退，終能時來運轉。", "aspects": { "求財": "有利", "婚姻": "可成", "功名": "漸得", "疾病": "漸安", "家運": "轉吉", "行人": "將至", "失物": "遲得", "訴訟": "漸解" } },
    { "no": 45, "gz": "辛巳", "level": "上", "poem": ["花開今已結成果", "富貴榮華終到老", "君子小人相會合", "萬事清吉莫煩惱"], "holy": "修成正果，富貴到老。", "explain": "如花開結果，努力終有成就，富貴榮華可享到老。無論何等人皆能相合，萬事清吉，不必煩憂。", "plain": "修成正果富貴到老，萬事清吉不必憂煩。", "aspects": { "求財": "豐收", "婚姻": "美滿到老", "功名": "成就", "疾病": "將癒", "家運": "富貴興旺", "行人": "歸", "失物": "得", "訴訟": "和吉" } },
    { "no": 46, "gz": "辛未", "level": "上", "poem": ["功名得意與君顯", "前途富貴喜安然", "若遇一輪明月照", "十五團圓光滿天"], "holy": "功名顯達，團圓光明。", "explain": "功名可望得意顯揚，前途富貴而安穩。如逢十五明月，光滿天際，諸事圓滿。", "plain": "功名顯達前途光明，如圓月當空指日可期。", "aspects": { "求財": "得利", "婚姻": "團圓美滿", "功名": "顯達", "疾病": "速癒", "家運": "光明興旺", "行人": "即歸", "失物": "可得", "訴訟": "得理" } },
    { "no": 47, "gz": "辛酉", "level": "中", "poem": ["君爾何須問聖跡", "自己心中皆有益", "於今且看月中旬", "凶事脫出化成吉"], "holy": "反求諸己，凶化為吉。", "explain": "答案其實已在自己心中，不必外求。待月中旬時機到來，凶險自能脫出、化為吉祥。", "plain": "答案早在心中，凶事終將化解為吉祥。", "aspects": { "求財": "漸有", "婚姻": "可成", "功名": "漸得", "疾病": "轉安", "家運": "轉吉", "行人": "月中至", "失物": "遲得", "訴訟": "漸解" } },
    { "no": 48, "gz": "辛亥", "level": "下", "poem": ["陽世作事未和同", "雲遮月色正朦朧", "心中意欲前途去", "只恐命內運未通"], "holy": "眾議未合，運塞宜守。", "explain": "所行之事眾人意見未能一致，情勢如雲遮月、朦朧不明。縱有心前進，時運未通仍宜守候。", "plain": "前路朦朧尚未明朗，行事宜靜待時運轉開。", "aspects": { "求財": "難得", "婚姻": "未合", "功名": "未遂", "疾病": "遷延", "家運": "欠安", "行人": "未歸", "失物": "難尋", "訴訟": "膠著" } },
    { "no": 49, "gz": "壬子", "level": "中", "poem": ["言語雖多不可從", "風雲靜處未行龍", "暗中終得明消息", "君爾何須問重重"], "holy": "勿聽讒言，佳音暗傳。", "explain": "他人議論雖多，不可輕信盲從。時機尚在靜候（未行龍），但暗中終有好消息傳來，不必反覆追問。", "plain": "他人言語紛擾不必輕信，佳音終將暗中傳來。", "aspects": { "求財": "待時有", "婚姻": "勿聽閒言則成", "功名": "暗中有得", "疾病": "漸安", "家運": "漸吉", "行人": "有暗信", "失物": "遲得", "訴訟": "宜緩" } },
    { "no": 50, "gz": "壬寅", "level": "中", "poem": ["佛前發誓無異心", "且看前途得好音", "此物原來本是鐵", "也能變化得成金"], "holy": "誠心不二，鐵可成金。", "explain": "在神佛前立誓、心無二意，前途便有好消息。原本看似不佳之事，也能因誠心而扭轉、化鐵成金。", "plain": "誠心不變終見好音，逆境亦能轉化為佳境。", "aspects": { "求財": "誠心可得", "婚姻": "誠則成", "功名": "轉機可得", "疾病": "轉安", "家運": "轉吉", "行人": "有好音", "失物": "遲得", "訴訟": "轉圜可解" } },
    { "no": 51, "gz": "壬辰", "level": "中", "poem": ["東西南北不堪行", "前途此事正可當", "勸君把定莫煩惱", "家門自有保安康"], "holy": "四方難行，守中則安。", "explain": "此時四處奔走皆不宜，唯有守住眼前本分之事方為正道。把持定見、不必煩惱，家門自能安康。", "plain": "行止宜謹慎沉穩，安守本分自得家門康泰。", "aspects": { "求財": "守分則安", "婚姻": "宜守", "功名": "宜守待時", "疾病": "宜靜養", "家運": "守則安康", "行人": "遲歸", "失物": "在家中", "訴訟": "宜守和" } },
    { "no": 52, "gz": "壬午", "level": "中", "poem": ["功名事業本由天", "不須掛念意懸懸", "若問中間遲與速", "風雲際會在眼前"], "holy": "功名由天，機會在前。", "explain": "功名事業自有天定，不必終日掛心懸念。若問快慢，其實風雲際會的時機已近在眼前。", "plain": "功名自有天定，不必掛心，時機將至眼前。", "aspects": { "求財": "將有", "婚姻": "隨緣可成", "功名": "機會在前", "疾病": "漸安", "家運": "漸吉", "行人": "將至", "失物": "遲得", "訴訟": "將解" } },
    { "no": 53, "gz": "壬申", "level": "上", "poem": ["看君來問心中事", "積善之家慶有餘", "運亨財子雙雙至", "指日喜氣溢門閭"], "holy": "積善餘慶，財子雙全。", "explain": "積善之家必有餘慶。時運亨通，財帛與子嗣（或喜事）雙雙而至，不日喜氣盈門。", "plain": "積善之家福澤深厚，財子雙全喜氣盈門。", "aspects": { "求財": "雙至", "婚姻": "大吉", "功名": "有得", "疾病": "轉安", "家運": "喜氣盈門", "行人": "即歸", "失物": "可得", "訴訟": "得理" } },
    { "no": 54, "gz": "壬戌", "level": "中", "poem": ["孤燈寂寂夜沉沉", "萬事清吉萬事成", "若逢陰中有善果", "燒得好香達神明"], "holy": "靜心行善，誠敬得福。", "explain": "縱處孤寂靜夜，只要靜心行善，萬事終能清吉而成。暗中所種善因必有善果，誠心敬神則福至。", "plain": "靜心行善終有所成，誠心敬神可保平安。", "aspects": { "求財": "漸有", "婚姻": "可成", "功名": "誠則得", "疾病": "作福漸安", "家運": "漸吉", "行人": "將至", "失物": "遲得", "訴訟": "漸解" } },
    { "no": 55, "gz": "癸丑", "level": "下", "poem": ["須知進退總言虛", "看看發暗未必全", "珠玉深藏還未變", "心中但得枉徒然"], "holy": "表暗裡明，徒憂無益。", "explain": "進退之言多屬虛談，表面看似暗淡，其實未必盡然——如珠玉深藏、本質未變。空自憂心並無助益。", "plain": "表面看似難全，實則珠玉暗藏，徒憂無益。", "aspects": { "求財": "暫難見", "婚姻": "未明", "功名": "藏而未顯", "疾病": "遷延", "家運": "外憂內安", "行人": "未歸", "失物": "在暗處", "訴訟": "膠著" } },
    { "no": 56, "gz": "癸卯", "level": "下", "poem": ["病中若得苦心勞", "到底完全總未遭", "去後不須回頭問", "心中事務盡消磨"], "holy": "辛勞漸消，勿再回顧。", "explain": "病中或困頓中的辛勞，終究不至於全盤皆輸。事過之後不必回頭追問，心中掛礙也將逐漸消解。", "plain": "病中辛勞漸消，不必回頭掛念，寬心靜養。", "aspects": { "求財": "難得", "婚姻": "難成", "功名": "未遂", "疾病": "宜靜養，漸消", "家運": "先勞後安", "行人": "未歸", "失物": "不得", "訴訟": "拖延後了" } },
    { "no": 57, "gz": "癸巳", "level": "上", "poem": ["勸君把定心莫虛", "前途清吉得運時", "到底中間無大事", "又遇神仙守安居"], "holy": "心定運通，神明護居。", "explain": "把持定見、心志不虛，前途便清吉得運。過程中並無大礙，且有神明庇佑，安居樂業。", "plain": "心誠意堅前路清吉，終得神明庇佑安居樂業。", "aspects": { "求財": "得利", "婚姻": "成", "功名": "得", "疾病": "轉安", "家運": "安居清吉", "行人": "平安歸", "失物": "可得", "訴訟": "無事" } },
    { "no": 58, "gz": "癸未", "level": "中", "poem": ["蛇身意欲變成龍", "只恐命內運未通", "久病且作寬心坐", "言語雖多不可從"], "holy": "蛻變在望，時運未至。", "explain": "有由弱轉強之志（蛇欲成龍），只是時運尚未打通。久病或久困者宜寬心靜候，他人閒言不可輕信。", "plain": "蛻變在望但時運未通，宜寬心靜候，勿聽妄言。", "aspects": { "求財": "待時", "婚姻": "宜緩", "功名": "晚成", "疾病": "宜寬心靜養", "家運": "先困後通", "行人": "遲歸", "失物": "遲得", "訴訟": "宜緩" } },
    { "no": 59, "gz": "癸酉", "level": "上", "poem": ["有心作福莫遲疑", "求名清吉正當時", "此事必能成會合", "財寶自然喜相隨"], "holy": "把握良機，財喜相隨。", "explain": "有心行善積福就不要遲疑，此時求名正當其時。所謀之事必能成就會合，財帛喜慶自然相隨。", "plain": "誠心行善把握良機，財利姻緣皆能如願。", "aspects": { "求財": "順得", "婚姻": "會合可成", "功名": "正當時可得", "疾病": "速癒", "家運": "興旺", "行人": "即歸", "失物": "可得", "訴訟": "得理" } },
    { "no": 60, "gz": "癸亥", "level": "中", "poem": ["月出光輝本清吉", "浮雲總是蔽陰色", "戶內用心再作福", "當官分理便有益"], "holy": "清光暫掩，行善則明。", "explain": "本是清吉光明之運，只是一時被浮雲遮蔽。宜於家中用心行善，遇事秉公處理，自然轉為有益。", "plain": "清吉光明終將顯現，浮雲遮蔽只是一時，用心行善可保平安。", "aspects": { "求財": "待雲開則有", "婚姻": "先阻後成", "功名": "秉公可得", "疾病": "作福漸安", "家運": "先掩後明", "行人": "將至", "失物": "遲得", "訴訟": "秉理可解" } }
  ]
}
